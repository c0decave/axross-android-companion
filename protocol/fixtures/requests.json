{
  "description": "Requests and what the companion's check of their parameters says (docs/PROTOCOL.md, section 7): 'ok', or the error code (and, for bad_request, the field). These are the checks only: an 'ok' request can still fail on the phone (permission_denied, not_found, ...). Unknown parameters are ignored.",
  "cases": [
    {
      "name": "hello",
      "method": "hello",
      "params": {
        "protocols": [
          1
        ],
        "client": "axross",
        "client_version": "0.15.183"
      },
      "expect": "ok"
    },
    {
      "name": "hello with several versions",
      "method": "hello",
      "params": {
        "protocols": [
          3,
          2,
          1
        ]
      },
      "expect": "ok"
    },
    {
      "name": "hello without protocols",
      "method": "hello",
      "params": {},
      "expect": "bad_request",
      "field": "protocols"
    },
    {
      "name": "hello with an empty list",
      "method": "hello",
      "params": {
        "protocols": []
      },
      "expect": "bad_request",
      "field": "protocols"
    },
    {
      "name": "hello with a string version",
      "method": "hello",
      "params": {
        "protocols": [
          "1"
        ]
      },
      "expect": "bad_request",
      "field": "protocols"
    },
    {
      "name": "hello with a long client name",
      "method": "hello",
      "params": {
        "protocols": [
          1
        ],
        "client": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "expect": "bad_request",
      "field": "client"
    },
    {
      "name": "ping",
      "method": "ping",
      "params": {},
      "expect": "ok"
    },
    {
      "name": "status",
      "method": "status",
      "params": {},
      "expect": "ok"
    },
    {
      "name": "subscriptions",
      "method": "subscriptions.list",
      "params": {},
      "expect": "ok"
    },
    {
      "name": "contacts, defaults",
      "method": "contacts.list",
      "params": {},
      "expect": "ok"
    },
    {
      "name": "contacts, a page",
      "method": "contacts.list",
      "params": {
        "offset": 1000,
        "limit": 1000
      },
      "expect": "ok"
    },
    {
      "name": "contacts, limit 0",
      "method": "contacts.list",
      "params": {
        "limit": 0
      },
      "expect": "bad_request",
      "field": "limit"
    },
    {
      "name": "contacts, limit 1001",
      "method": "contacts.list",
      "params": {
        "limit": 1001
      },
      "expect": "bad_request",
      "field": "limit"
    },
    {
      "name": "contacts, negative offset",
      "method": "contacts.list",
      "params": {
        "offset": -1
      },
      "expect": "bad_request",
      "field": "offset"
    },
    {
      "name": "contacts, fractional limit",
      "method": "contacts.list",
      "params": {
        "limit": 10.5
      },
      "expect": "bad_request",
      "field": "limit"
    },
    {
      "name": "contact photo",
      "method": "contacts.photo",
      "params": {
        "contact_id": 42
      },
      "expect": "ok"
    },
    {
      "name": "contact photo, full size",
      "method": "contacts.photo",
      "params": {
        "contact_id": 42,
        "size": "full"
      },
      "expect": "ok"
    },
    {
      "name": "contact photo, id 0",
      "method": "contacts.photo",
      "params": {
        "contact_id": 0
      },
      "expect": "bad_request",
      "field": "contact_id"
    },
    {
      "name": "contact photo, bad size",
      "method": "contacts.photo",
      "params": {
        "contact_id": 42,
        "size": "huge"
      },
      "expect": "bad_request",
      "field": "size"
    },
    {
      "name": "contact photo, id as string",
      "method": "contacts.photo",
      "params": {
        "contact_id": "42"
      },
      "expect": "bad_request",
      "field": "contact_id"
    },
    {

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- What the app may do: read and send SMS, read MMS (READ_SMS), hear of
         new ones, read contacts, list the SIMs (READ_PHONE_STATE), show its
         notification, run its service. No INTERNET, no network state, no
         storage: nothing leaves the phone but through the ADB socket
         (docs/SECURITY.md). scripts/ci/check_manifest.py fails the build if
         that changes. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- (installs on phones without telephony too; there it lists contacts
         and answers no_subscription to a send) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/CompanionTheme"
        android:usesCleartextTraffic="false">

        <!-- The one screen (the launcher's). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The restore question: opened from the app's own notification. -->
        <activity
            android:name=".RestoreActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- The listening service. Exported only to holders of DUMP: the
             shell (adb shell am start-foreground-service) and the system,
             no app. Even started, it serves only uid 2000 and 0. -->
        <service
            android:name=".CompanionService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />

        <!-- The companion's own send results (its PendingIntents). -->
        <receiver
            android:name=".SmsStatusReceiver"
            android:exported="false" />

        <!-- What Android requires of an app that can be the default SMS app
             (needed for restore and delete; only the system can reach these,
             each guarded by a permission only the system holds). The
             companion sends nothing for them. -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RespondService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Exported (other apps' "send SMS" links land here when the
             companion is the default): it only says that it writes nothing
             and closes. -->
        <activity
            android:name=".ComposeActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
    </application>
</manifest>

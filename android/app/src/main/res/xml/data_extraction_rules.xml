<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app is backed up or moved to another device - also not
     its send store (no_backup/sends.json, the numbers of the SMS it sent in
     the last day): a store that came back from a backup would say that the
     phone sent what a restored phone never sent. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
